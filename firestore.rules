rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── 設定（読み取り専用） ────────────────────
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ─── 選挙 ───────────────────────────────────
    match /elections/{electionId} {
      allow read: if true;
      allow write: if false; // 管理はFirebaseコンソールから

      // ─── 投票 ────────────────────────────────
      match /votes/{voteId} {
        allow read: if true;

        // 新規作成のみ許可：
        // 1. 匿名認証済みユーザー
        // 2. voteId == auth.uid（1デバイス1票）
        // 3. 自分のdeviceIdで書いている
        // 4. 必須フィールドがある
        allow create: if
          request.auth != null
          && voteId == request.auth.uid
          && request.resource.data.deviceId == request.auth.uid
          && request.resource.data.choice in ['A', 'B', 'C']
          && request.resource.data.agreeReason is string
          && request.resource.data.agreeReason.size() >= 5
          && request.resource.data.agreeReason.size() <= 200
          && request.resource.data.voteWeight in [1, 2];

        // hidden フィールドのみ更新可（管理者による非表示操作）
        allow update: if
          request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
          && request.resource.data.hidden is bool;
        allow delete: if false;
      }

      // ─── 再訪記録 ─────────────────────────────────
      match /deviceVisits/{visitDeviceId} {
        allow read: if request.auth != null;
        allow create: if
          request.auth != null
          && visitDeviceId == request.auth.uid;
        allow update: if
          request.auth != null
          && visitDeviceId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['visitCount', 'visitTimestamps', 'lastVisitAt']);
        allow delete: if false;
      }

      // ─── セッション行動ログ ───────────────────────
      match /sessions/{sessionDeviceId} {
        allow read: if request.auth != null;
        // 自分のuidドキュメントのみ作成・更新可（荒らし防止）
        allow create, update: if
          request.auth != null
          && sessionDeviceId == request.auth.uid
          && request.resource.data.deviceId == request.auth.uid;
        allow delete: if false;
      }

      // ─── 共感 ─────────────────────────────────────
      match /sympathies/{sympathyId} {
        allow read: if request.auth != null;
        allow create: if
          request.auth != null
          && request.resource.data.deviceId == request.auth.uid;
        allow update, delete: if false;
      }

      // ─── 自由記述提案 ────────────────────────────
      match /suggestions/{suggestionId} {
        allow read: if false;
        allow create: if
          request.auth != null
          && request.resource.data.deviceId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 150;
        allow update, delete: if false;
      }
    }
  }
}
